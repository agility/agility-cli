{
  "name": "@agility/cli",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agility/agility-cli.git"
  },
  "bugs": {
    "url": "https://github.com/agility/agility-cli/issues"
  },
  "homepage": "https://github.com/agility/agility-cli#readme",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc -p . && node -e \"console.log('✓ TypeScript compiled to dist/')\"",
    "postbuild": "node -e \"require('fs').chmodSync('dist/index.js', 0o755); console.log('✓ chmod +x dist/index.js')\"",
    "refresh": "rm -rf ./node_modules ./package-lock.json && npm install",
    "test": "jest",
    "test:unit": "jest",
    "test:integration": "jest --testMatch=\"**/*.integration.test.ts\" --testPathIgnorePatterns=\"/node_modules/|/dist/|/src/index.ts\"",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "debug": "node --inspect-brk -r ts-node/register src/index.ts"
  },
  "keywords": [
    "typescript",
    "agility",
    "cms",
    "headlesscms",
    "management-api",
    "management-api-cli"
  ],
  "author": "Agility CMS",
  "contributors": [
    "Joel Varty",
    "Aaron Taylor",
    "Kevin Tran",
    "Jules Exel",
    "Derek Lo",
    "Mohit Vashishtha"
  ],
  "license": "ISC",
  "bin": {
    "agility-cli": "dist/index.js",
    "agility": "dist/index.js"
  },
  "overrides": {
    "rxjs": "^7.8.2"
  },
  "dependencies": {
    "@agility/content-sync": "^1.2.0",
    "@agility/management-sdk": "^0.1.38",
    "ansi-colors": "^4.1.3",
    "axios": "^0.27.2",
    "cli-progress": "^3.11.2",
    "date-fns": "^4.1.0",
    "dotenv": "^8.6.0",
    "form-data": "^4.0.5",
    "inquirer": "^8.0.0",
    "inquirer-search-list": "^1.2.6",
    "keytar": "^7.9.0",
    "lodash": "^4.17.21",
    "open": "^8.4.0",
    "proper-lockfile": "^4.1.2",
    "tsconfig-paths": "^4.2.0",
    "yargs": "^17.6.2"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.11.17",
    "@types/yargs": "^17.0.17",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "prettier": "3.8.3",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
